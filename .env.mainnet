# Sparket Miner — MAINNET production environment
# ------------------------------------------------
# Load before starting:
#   set -a && source .env.mainnet && set +a
#   python sparket/entrypoints/miner.py
#
# Or via PM2:
#   pm2 start ecosystem.miner.config.js

# --- Role ---
SPARKET_ROLE=miner

# --- Chain (Bittensor MAINNET) ---
SPARKET_SUBTENSOR__NETWORK=finney
# Set the confirmed mainnet netuid (verify at https://taostats.io)
SPARKET_CHAIN__NETUID=57

# --- Config file ---
SPARKET_MINER_CONFIG_FILE=sparket/config/miner.mainnet.yaml
SPARKET_CONFIG_FILE=sparket/config/miner.mainnet.yaml

# --- Wallet ---
# Use a dedicated mainnet coldkey + hotkey for Sparket
SPARKET_WALLET__NAME=darnsin01
SPARKET_WALLET__HOTKEY=sparket-miner-04220

# --- Axon ---
SPARKET_AXON__HOST=0.0.0.0
SPARKET_AXON__PORT=8094
# Set your VPS public IP (required if behind NAT or cloud firewall):
# SPARKET_AXON__EXTERNAL_IP=<your-vps-public-ip>
# SPARKET_AXON__EXTERNAL_PORT=8094

# --- Disable base miner — competitive service takes over ---
SPARKET_BASE_MINER__ENABLED=false

# --- Database (production Postgres on default port) ---
SPARKET_DATABASE__HOST=127.0.0.1
SPARKET_DATABASE__PORT=5432
SPARKET_DATABASE__USER=sparket
SPARKET_DATABASE__PASSWORD=Password123!@#
SPARKET_DATABASE__NAME=sparket_miner

# --- Control API (local monitoring) ---
SPARKET_MINER_API_ENABLED=true
SPARKET_MINER_API_PORT=8198

# --- Competitive service settings ---
# Leagues to submit on (comma-separated). Start focused; expand as model validates.
COMPETITIVE_LEAGUES=mlb,epl,nba

# Submission cadence in seconds (900 = 15 min default; lower on high-volume days)
COMPETITIVE_ODDS_INTERVAL=900

# Outcome check cadence in seconds
COMPETITIVE_OUTCOME_INTERVAL=300

# Maximum markets per batch submission (keep at 50-100)
COMPETITIVE_BATCH_SIZE=75

# Minimum hours before game start to submit (earlier = better timeliness score)
# 0 = submit as soon as game enters acceptance window (up to 7 days ahead)
COMPETITIVE_MIN_HOURS_BEFORE=0

# Skip markets where consensus probability is >= this value (sentinel/no-data marker)
COMPETITIVE_SENTINEL_THRESHOLD=0.98

# Optional: The-Odds-API key for reference line movement data (free: 500 req/month)
# SPARKET_BASE_MINER__ODDS_API_KEY=your_key_here

# --- Runtime ---
SPARKET_TEST_MODE=false
PYTHONUNBUFFERED=1
