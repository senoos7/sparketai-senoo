# Sparket Miner - Bittensor TESTNET environment
# ------------------------------------------------
# Copy this to .env.test, then load it before running:
#   set -a && source .env.test && set +a
#   python sparket/entrypoints/miner.py
#
# Or via the setup script:
#   bash scripts/setup_miner_test.sh

# --- Role ---
SPARKET_ROLE=miner

# --- Config file (miner-specific testnet YAML) ---
SPARKET_MINER_CONFIG_FILE=sparket/config/miner.test.yaml
SPARKET_CONFIG_FILE=sparket/config/miner.test.yaml

# --- Chain (Bittensor testnet) ---
SPARKET_SUBTENSOR__NETWORK=test
# Sparket testnet netuid — verify at https://x.taostats.io/?network=test
# Override here once you confirm the testnet netuid:
# SPARKET_CHAIN__NETUID=57

# --- Wallet ---
# Reuse your existing testnet coldkey with a new sparket-specific hotkey
SPARKET_WALLET__NAME=itsai-testnet-cold0
SPARKET_WALLET__HOTKEY=sparket-miner

# --- Axon ---
SPARKET_AXON__HOST=0.0.0.0
SPARKET_AXON__PORT=8094
# Uncomment and set if behind NAT or cloud firewall:
# SPARKET_AXON__EXTERNAL_IP=<your-vps-public-ip>
# SPARKET_AXON__EXTERNAL_PORT=8094

# --- Database (isolated test DB on port 5435) ---
SPARKET_DATABASE__HOST=127.0.0.1
SPARKET_DATABASE__PORT=5435
SPARKET_DATABASE__USER=sparket
SPARKET_DATABASE__PASSWORD=sparket
SPARKET_DATABASE__NAME=sparket_miner_test
# Full URL alternative (uncomment to use instead of fields above):
# DATABASE_URL=postgresql+asyncpg://sparket:sparket@127.0.0.1:5435/sparket_miner_test

# --- Base miner ---
# Keep enabled for initial connectivity test; disable once your custom model is ready
SPARKET_BASE_MINER__ENABLED=true
SPARKET_BASE_MINER__ODDS_REFRESH_SECONDS=900
SPARKET_BASE_MINER__OUTCOME_CHECK_SECONDS=300

# --- Control API (optional local status endpoint) ---
SPARKET_MINER_API_ENABLED=true
SPARKET_MINER_API_PORT=8198

# --- Runtime ---
SPARKET_TEST_MODE=false
PYTHONUNBUFFERED=1

# --- Optional: The-Odds-API key for base miner data (free tier available) ---
# SPARKET_BASE_MINER__ODDS_API_KEY=your_key_here
